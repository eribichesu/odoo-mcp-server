# Example environment configuration for Odoo MCP Server
# Copy this file to .env and update with your actual values

# Odoo instance configuration
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DATABASE=your_database_name
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_password

# API key (Preferences > Account Security > New API Key).
# REQUIRED for the JSON-2 transport (Odoo 19+) and required for XML-RPC when
# two-factor authentication (2FA) is enabled on the account — with 2FA on, the
# plain password will NOT work over the API.
ODOO_API_KEY=

# Transport selection:
#   auto   - JSON-2 when ODOO_API_KEY is set, otherwise XML-RPC (default)
#   json2  - force the Odoo 19+ /json/2 endpoint (requires ODOO_API_KEY)
#   xmlrpc - force the legacy /xmlrpc/2 endpoint (Odoo <= 18; deprecated in 19)
ODOO_TRANSPORT=auto

# Optional Odoo settings
ODOO_TIMEOUT=30
ODOO_MAX_RETRIES=3
ODOO_RETRY_DELAY=1.0

# MCP server configuration
SERVER_NAME=odoo-mcp
SERVER_VERSION=0.2.0

# Debug and logging
DEBUG=False
LOG_LEVEL=INFO

# Operation limits
DEFAULT_LIMIT=100
MAX_LIMIT=1000